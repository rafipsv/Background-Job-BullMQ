                  "if (jsonData.status === 'completed') {",
                  "    pm.test('Retry demo eventually completed', function () {",
                  "        pm.expect(jsonData.status).to.eql('completed');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "response": []
