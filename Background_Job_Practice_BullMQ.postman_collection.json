{
  "info": {
    "_postman_id": "5a5f17a2-b31c-49a1-9b3f-9ad0e5f43821",
    "name": "Background Job Practice - BullMQ",
    "description": "Postman collection for practicing Background Jobs with Node.js, Express, BullMQ and Redis.\n\nRun Redis, `node server.js`, and `node worker.js` before testing normal/retry/fail cases.\nFor the waiting-job test, stop the worker first, create a job, check that it is waiting, then restart the worker.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "jobId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Normal Success Flow",
      "item": [
        {
          "name": "Create Monthly Sales Report",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportType\": \"monthly-sales\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 202', function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "pm.test('Response contains jobId', function () {",
                  "    pm.expect(jsonData.jobId).to.exist;",
                  "});",
                  "",
                  "if (jsonData.jobId) {",
                  "    pm.collectionVariables.set('jobId', jsonData.jobId);",
                  "    console.log('Saved jobId:', jsonData.jobId);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Check Current Job Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "{{jobId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "pm.test('Job status is valid', function () {",
                  "    pm.expect(['waiting','active','completed','failed','delayed','paused','waiting-children','unknown']).to.include(jsonData.status);",
                  "});",
                  "",
                  "console.log('Job status:', jsonData.status);",
                  "console.log('Progress:', jsonData.progress);"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
