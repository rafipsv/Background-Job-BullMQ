                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 202', function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "if (jsonData.jobId) {",
                  "    pm.collectionVariables.set('jobId', jsonData.jobId);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Check Failed Job Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "{{jobId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "console.log('Failure status:', jsonData.status);",
                  "console.log('Attempts made:', jsonData.attemptsMade);",
                  "console.log('Failed reason:', jsonData.failedReason);",
                  "",
                  "if (jsonData.status === 'failed') {",
                  "    pm.test('Job failed after retries', function () {",
                  "        pm.expect(jsonData.failedReason).to.exist;",
                  "        pm.expect(jsonData.attemptsMade).to.be.at.least(1);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "04 - Worker Offline / Waiting Job",
      "description": "Stop `node worker.js` before running the create request. Then check status: it should normally be `waiting`. Restart the worker afterward and check status again.",
      "item": [
        {
          "name": "Create Job While Worker Is OFF",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reportType\": \"yearly-sales\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/reports",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 202', function () {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "if (jsonData.jobId) {",
                  "    pm.collectionVariables.set('jobId', jsonData.jobId);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Check Job Is Waiting",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "{{jobId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "console.log('Worker-off status:', jsonData.status);",
                  "",
                  "pm.test('Job is waiting while worker is offline', function () {",
                  "    pm.expect(['waiting','delayed']).to.include(jsonData.status);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Check Again After Restarting Worker",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports/{{jobId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reports",
                "{{jobId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "console.log('After worker restart:', jsonData.status);",
                  "",
                  "if (jsonData.status === 'completed') {",
                  "    pm.test('Waiting job completed after worker restart', function () {",
                  "        pm.expect(jsonData.status).to.eql('completed');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
